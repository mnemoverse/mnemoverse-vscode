{
  "name": "mnemoverse-vscode",
  "displayName": "Mnemoverse Memory",
  "description": "Persistent memory for GitHub Copilot agent mode that learns from outcomes, with shared rooms. The same memory follows you across Claude, Cursor and ChatGPT — sign in once in the browser.",
  "version": "0.2.1",
  "publisher": "Mnemoverse",
  "preview": true,
  "pricing": "Free",
  "license": "MIT",
  "homepage": "https://mnemoverse.com/docs/api/mcp-server",
  "bugs": {
    "url": "https://github.com/mnemoverse/mnemoverse-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mnemoverse/mnemoverse-vscode.git"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/mnemoverse"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "ai-agent",
    "copilot",
    "copilot-chat",
    "agent-mode",
    "mnemoverse",
    "persistent-memory",
    "shared-memory",
    "cross-tool",
    "model-context-protocol",
    "mcp-server",
    "github-copilot",
    "long-term-memory",
    "agent-memory",
    "claude",
    "cursor",
    "chatgpt",
    "memory-rooms"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension spawns the @mnemoverse/mcp-memory-server npm package via npx. Running arbitrary third-party code requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "This extension spawns a local process via npx, which is unavailable in virtual workspaces such as github.dev or vscode.dev."
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "mnemoverse.memory",
        "label": "Mnemoverse Memory"
      }
    ],
    "commands": [
      {
        "command": "mnemoverse.signIn",
        "title": "Sign In",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.completeSignIn",
        "title": "Complete sign-in",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.signOut",
        "title": "Sign Out",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.setApiKey",
        "title": "Set API Key (paste manually)",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.clearApiKey",
        "title": "Clear API Key",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.openDocs",
        "title": "Open Documentation",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.copyMcpConfig",
        "title": "Copy MCP Config",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.openMcpSettings",
        "title": "Open MCP Settings",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.useHostedConnection",
        "title": "Use Hosted Connection (no Node.js)",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.useLocalConnection",
        "title": "Use Local Connection (npx)",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.getStarted",
        "title": "Get Started",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.tryIt",
        "title": "Try It in Chat",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.showMenu",
        "title": "Show Menu",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.showLog",
        "title": "Show Log",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.rate",
        "title": "Rate Mnemoverse",
        "category": "Mnemoverse"
      },
      {
        "command": "mnemoverse.starOnGitHub",
        "title": "Star on GitHub",
        "category": "Mnemoverse"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mnemoverse.useHostedConnection",
          "when": "mnemoverse.host == lm && config.mnemoverse.connection != hosted"
        },
        {
          "command": "mnemoverse.useLocalConnection",
          "when": "mnemoverse.host == lm && config.mnemoverse.connection == hosted"
        }
      ]
    },
    "configuration": {
      "title": "Mnemoverse",
      "properties": {
        "mnemoverse.connection": {
          "type": "string",
          "enum": [
            "local",
            "hosted"
          ],
          "enumDescriptions": [
            "Run the memory server on this machine with npx (needs Node.js 18+). Connect with \"Mnemoverse: Sign In\"; the key is kept in the OS keychain.",
            "Use the hosted server at https://mcp.mnemoverse.com/mcp. The editor signs you in through the browser the first time the agent uses memory. No Node.js and no stored key."
          ],
          "default": "local",
          "scope": "application",
          "markdownDescription": "How Mnemoverse Memory connects in editors that support VS Code's MCP server API (VS Code, VSCodium, Positron, Theia). Cursor and other editors always use the hosted server."
        },
        "mnemoverse.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Mnemoverse item in the status bar."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "mnemoverse.getStarted",
        "title": "Get started with Mnemoverse Memory",
        "description": "Connect long-term memory to your editor's agent, check that it works, and share it through a room.",
        "steps": [
          {
            "id": "connect.lm",
            "title": "Connect your memory",
            "description": "Sign in through the browser; there is no key to copy. The agent in this editor then gets long-term memory tools.\n[Sign In](command:mnemoverse.signIn)\nNo Node.js on this machine? [Use the hosted connection](command:mnemoverse.useHostedConnection) instead.",
            "media": {
              "markdown": "media/walkthrough/connect-lm.md"
            },
            "completionEvents": [
              "onContext:mnemoverse.connected"
            ],
            "when": "mnemoverse.host == lm || !mnemoverse.host"
          },
          {
            "id": "connect.cursor",
            "title": "Sign in from Cursor's MCP settings",
            "description": "The extension added Mnemoverse to Cursor's MCP servers. Open Cursor Settings → Tools & MCPs and click Connect next to it; Cursor signs you in through the browser.\n[Open MCP settings](command:mnemoverse.openMcpSettings)",
            "media": {
              "markdown": "media/walkthrough/connect-cursor.md"
            },
            "completionEvents": [
              "onCommand:mnemoverse.openMcpSettings"
            ],
            "when": "mnemoverse.host == cursor"
          },
          {
            "id": "connect.guidance",
            "title": "Add Mnemoverse to your editor's MCP config",
            "description": "This editor doesn't let extensions add MCP servers yet. Copy a ready config for Mnemoverse's hosted server and paste it into the editor's MCP config file.\n[Copy config](command:mnemoverse.copyMcpConfig)",
            "media": {
              "markdown": "media/walkthrough/connect-guidance.md"
            },
            "completionEvents": [
              "onCommand:mnemoverse.copyMcpConfig"
            ],
            "when": "mnemoverse.host == guidance"
          },
          {
            "id": "tryIt",
            "title": "Try it",
            "description": "Ask the agent to remember something, then ask about it in a new chat.\n[Try it](command:mnemoverse.tryIt)",
            "media": {
              "markdown": "media/walkthrough/try-it.md"
            },
            "completionEvents": [
              "onCommand:mnemoverse.tryIt"
            ]
          },
          {
            "id": "shareRoom",
            "title": "Share memory through a room",
            "description": "A room is a memory pool you share with other people and agents (Beta). Ask the agent to create one and invite a teammate.\n[Read the docs](https://mnemoverse.com/docs)",
            "media": {
              "markdown": "media/walkthrough/share-room.md"
            },
            "completionEvents": [
              "onLink:https://mnemoverse.com/docs"
            ]
          }
        ]
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/mnemoverse-memory/SKILL.md",
        "when": "mnemoverse.connected"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "check:version": "node scripts/check-version.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.102.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
